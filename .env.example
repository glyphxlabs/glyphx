# SMTP settings for website inquiry forms
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@your-domain.com
SMTP_PASS=replace-with-password-or-app-key

# Optional sender header shown in inbox
SMTP_FROM=HyroGlyphX Website <mailer@your-domain.com>

# Optional override; defaults to contact@hyroglyphx.com
INQUIRY_RECIPIENT=contact@hyroglyphx.com